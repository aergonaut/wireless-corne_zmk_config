#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define FUNCT   3

/ {
    combos {
        compatible = "zmk,combos";
        combo_jk_esc {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp ESC>;
        };
    };
};

/ {
    behaviors {
        ft: fast_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Fast Layer-Tap";
        };
    };
};

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
        // zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp TAB     &kp Q   &kp W   &kp E       &kp R           &kp T           &kp Y           &kp U       &kp I       &kp O   &kp P       &kp BSPC
                &sk LALT    &kp A   &kp S   &kp D       &kp F           &kp G           &kp H           &kp J       &kp K       &kp L   &kp SEMI    &kp SQT
                &sk LSHFT   &kp Z   &kp X   &kp C       &kp V           &kp B           &kp N           &kp M       &kp COMMA   &kp DOT &kp FSLH    &sl FUNCT
                                            &sk LCTRL   &mt LGUI ENTER  &ft LOWER TAB   &ft RAISE BSPC  &kp SPACE   &sk RSHFT
            >;
        };

        lower_layer {
            bindings = <
                &trans      &kp EXCL    &kp AT      &kp POUND   &kp DLLR    &kp PRCNT   &kp CARET   &kp AMPS    &kp STAR    &kp LPAR   &kp RPAR     &kp BSPC
                &trans      &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9     &kp N0       &trans
                &trans      &trans      &kp TILDE   &kp GRAVE   &kp LBKT    &kp LBRC    &kp RBRC    &kp RBKT    &kp COMMA   &kp DOT    &kp FSLH     &trans
                                                    &trans      &trans      &trans      &trans      &trans      &kp COLON
            >;
        };

        raise_layer {
            bindings = <
                &trans      &kp DEL     &trans      &kp UNDER   &kp PLUS    &kp PG_UP   &trans      &trans      &trans      &kp BSLH    &kp PIPE    &kp DEL
                &trans      &kp HOME    &kp END     &kp MINUS   &kp EQUAL   &kp PG_DN   &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp K_APP   &trans
                &trans      &kp LT      &kp GT      &kp K_COPY  &kp K_PASTE &kp SEMI    &kp C_PLAY_PAUSE &kp C_PREVIOUS  &kp C_NEXT  &kp C_VOLUME_DOWN &kp C_VOLUME_UP &trans
                                                    &kp LC(ESC) &kp LG(RET) &trans      &trans      &trans      &trans
            >;
        };

        function_layer {
            bindings = <
                &bootloader &kp F1      &kp F2          &kp F3          &kp F4          &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &trans
                &trans      &kp F11     &kp F12         &trans          &trans          &trans      &trans      &trans      &trans      &trans      &trans      &trans
                &trans      &kp CAPS    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_CLR  &trans      &trans      &trans      &trans      &trans      &trans
                                                        &trans          &trans          &trans      &trans      &trans      &trans
            >;
        };
    };
};
